[Unit]
Description=VC Weather Shopify Backend
After=network.target

[Service]
WorkingDirectory=/opt/shopify-uyg935t84z/vc-weather-backend
EnvironmentFile=/opt/shopify-uyg935t84z/vc-weather-backend/.env
ExecStart=/opt/shopify-uyg935t84z/vc-weather-backend/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
User=ron
Group=ron

[Install]
WantedBy=multi-user.target
